# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (public — browser-safe, anon key only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — NEVER exposed to the client bundle) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (server-only) ---
# Pooled connection (pgbouncer, port 6543) — used at runtime by the app.
DATABASE_URL=
# Direct connection (port 5432) — used only by `prisma migrate`.
DIRECT_URL=

# --- Rate limiting (Upstash Redis, server-only) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Odoo HR integration (optional — the lookup stub works without these) ---
ODOO_BASE_URL=
ODOO_API_KEY=

# --- App ---
# Canonical origin used to build invite / auth-callback redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
